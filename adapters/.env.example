# Copy to adapters/.env (gitignored, never commit real values here) and fill in.

# Front-door API (seed_test_client.py, build_fixture_drafts.py) -- writes to
# whatever sb-ai deployment this points at. Only ever use --external-client-id
# values you made up for testing, never a real client's.
SB_AI_URL=
SB_AI_API_KEY=

# Internal Python inference endpoint (transaction_categorizer.py, the actual
# eval-time agent) -- side-effect-free, no DB writes.
PYTHON_BACKEND_URL=
INTERNAL_SERVICE_KEY=
